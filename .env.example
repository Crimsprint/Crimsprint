# Supabase → Project Settings → API. The publishable (or legacy anon) key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: Desmos API key (desmos.com/my-api). Without it the calculator runs in scientific (non-graphing) mode.
NEXT_PUBLIC_DESMOS_API_KEY=
